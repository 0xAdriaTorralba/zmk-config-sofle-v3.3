#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <400>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <900>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    behaviors {
        num_tab: num_tab {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        service_mode: service_mode {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <0>;
        };

        c_trencada: c_trencada {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <42>;
        };

        enya: enya {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <46>;
        };

        generic_tap_hold: generic_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <12 11 37>;
        };

        cmd_space: cmd_space {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LG(SPACE)>;

            tapping-term-ms = <200>;
        };

        lhmod: lhmod {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <50>;
        };

        rhmod: rhmod {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <50>;
        };
    };

    macros {
        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(EQUAL)))>;
        };

        next_page: next_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SINGLE_QUOTE)>;
        };

        previous_page: previous_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SEMICOLON)>;
        };

        // Literal ^ ~ ` for SYM: the dead key, then SPACE
        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp SPACE>;
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(SEMI) &kp SPACE>;
        };

        grave_lit: grave_lit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp SPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
            // ADJUST only (SYM + RAISE held): on base, the combo held back every S (a home-row mod) press
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&service_mode LS(LA(APOSTROPHE)) GRAVE  &kp N1               &kp N2          &kp N3                   &kp N4             &kp N5                &kp UP_ARROW     &kp N6             &kp N7              &kp N8              &kp N9          &generic_tap_hold LS(MINUS) MINUS            &generic_tap_hold EQUAL N0
&num_tab 4 TAB                          &kp Q                &kp W           &kp E                    &kp R              &kp T                 &kp DOWN_ARROW   &kp Y              &rhmod RIGHT_GUI U  &rhmod RIGHT_ALT I  &rhmod RCTRL O  &rhmod RIGHT_SHIFT P                         &generic_tap_hold RBKT LBKT
&kp CAPS                                &lhmod LEFT_SHIFT A  &lhmod LCTRL S  &lhmod LEFT_ALT D        &lhmod LEFT_GUI F  &kp G                 &kp LEFT_ARROW   &kp H              &kp J               &kp K               &kp L           &kp SINGLE_QUOTE                             &kp ENTER
&kp LSHFT                               &kp Z                &kp X           &c_trencada BACKSLASH C  &kp V              &kp B                 &kp RIGHT_ARROW  &enya SEMICOLON N  &kp M               &kp COMMA           &kp DOT         &kp FSLH                                     &kp RSHFT
&kp C_MUTE                              &kp LCTRL            &kp LALT        &kp LEFT_GUI             &kp BSPC           &cmd_space            &kp ENTER        &mo 2              &kp SPACE           &kp RGUI            &kp RALT        &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "default";
        };

        lower_layer {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &mmv MOVE_UP     &kp F6             &kp F7                &kp F8                 &kp F9                &kp F10              &trans
&trans      &kp LS(N1)           &kp RA(N2)           &kp RA(N3)           &kp LS(N4)           &kp LS(N5)           &mmv MOVE_DOWN   &kp RA(GRAVE)  &kp LS(N8)     &kp LS(N9)     &kp LS(MINUS)  &kp RBKT       &trans
&trans      &trans               &kp RA(N1)           &kp LS(N0)           &kp LS(N6)           &kp MINUS            &mmv MOVE_LEFT   &kp LS(N7)     &kp RA(LBKT)   &kp RA(RBKT)   &grave_lit     &kp LS(N2)     &trans
&trans      &kp NON_US_BSLH      &kp LS(NON_US_BSLH)  &kp LS(FSLH)         &caret               &kp LS(RBKT)         &mmv MOVE_RIGHT  &tilde         &kp RA(SQT)    &kp RA(BSLH)   &kp LS(N3)     &kp FSLH       &trans
&kp C_MUTE  &trans  &trans  &trans  &trans  &trans    &mkp LCLK        &trans             &trans                &trans                 &trans                &trans
            >;

            display-name = "lower";
            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
&kp GRAVE   &kp F1  &kp F2  &kp F3  &kp F4      &kp F5    &kp UP_ARROW  &kp F6          &kp F7          &kp F8        &kp F9      &kp F10  &kp F11
&trans      &trans  &trans  &trans  &trans      &trans    &kp DOWN_ARROW  &trans        &trans          &kp HOME      &kp END     &trans   &kp F12
&trans      &trans  &trans  &trans  &trans      &trans    &kp LEFT_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW   &trans   &trans
&trans      &trans  &trans  &trans  &trans      &trans    &kp RIGHT_ARROW     &previous_page  &kp PG_DN   &kp PG_UP   &next_page  &trans   &trans
&kp C_MUTE  &trans  &trans  &trans  &kp DELETE  &trans    &kp ESC       &trans          &trans          &trans        &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_INC C_BRI_DEC>;
        };

        adjust_layer {
            display-name = "adjust";
            bindings = <
&kp GRAVE   &kp F1  &kp F2           &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7      &kp F8    &kp F9      &kp F10  &kp F11
&trans      &trans  &trans           &trans           &trans           &trans             &mmv MOVE_DOWN   &trans           &trans      &trans    &trans      &trans   &trans
&trans      &trans  &trans           &trans           &trans           &to 5              &mmv MOVE_LEFT   &kp PG_DN        &trans      &trans    &trans      &trans   &trans
&trans      &trans  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp F12  &trans
&kp C_MUTE  &trans  &trans           &trans           &trans           &trans             &mkp LCLK        &trans           &trans      &trans    &trans      &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        numeric_layer {
            display-name = "num";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &trans  &trans  &kp PERCENT  &kp LS(N7)             &trans  &trans
&trans      &kp TAB       &kp LS(TAB)   &trans        &trans        &trans          &mmv MOVE_DOWN   &kp N7  &kp N8  &kp N9       &kp LS(RIGHT_BRACKET)  &trans  &trans
&trans      &trans        &sleep        &trans        &trans        &trans          &mmv MOVE_LEFT   &kp N4  &kp N5  &kp N6       &kp SLASH              &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &mmv MOVE_RIGHT  &kp N1  &kp N2  &kp N3       &kp RIGHT_BRACKET      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &mkp LCLK        &trans  &kp N0  &kp DOT      &kp ENTER             &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        game_layer {
            display-name = "game";
            bindings = <
&kp GRAVE   &kp N1     &kp N2    &kp N3                   &kp N4    &kp N5        &kp UP_ARROW     &kp N6             &kp N7     &kp N8     &kp N9    &generic_tap_hold LS(MINUS) MINUS  &generic_tap_hold EQUAL N0
&kp TAB     &kp Q      &kp W     &kp E                    &kp R     &kp T         &kp DOWN_ARROW   &kp Y              &kp U      &kp I      &kp O     &kp P                              &kp RBKT
&kp ESCAPE  &kp A      &kp S     &kp D                    &kp F     &kp G         &kp LEFT_ARROW   &kp H              &kp J      &kp K      &kp L     &kp BACKSLASH                      &kp ENTER
&kp LSHFT   &kp Z      &kp X     &kp C                    &kp V     &kp B         &kp RIGHT_ARROW  &kp N              &kp M      &kp COMMA  &kp DOT   &kp FSLH                           &kp RSHFT
&kp C_MUTE  &kp LCTRL  &kp LALT  &kp LGUI                 &kp BSPC  &cmd_space    &to 0            &mo 2              &kp SPACE  &kp RGUI   &kp RALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
